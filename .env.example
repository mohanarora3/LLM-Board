# Copy this file to .env and add your keys. Never commit .env.

# ── Required ───────────────────────────────────────────────────────────────
# Free key (250 searches/month): https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

# ── The clerk (LLM) ────────────────────────────────────────────────────────
# Optional but recommended: records claims, referees the debate, writes the
# verdict. Without one, LLM Council still works by matching sentences.
# LLM_PROVIDER=auto picks the first key below that is set.
LLM_PROVIDER=auto

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Ollama, LM Studio)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# Override the model for the chosen provider, e.g. gemini-2.5-flash
LLM_MODEL=

# ── Debate ─────────────────────────────────────────────────────────────────
# Maximum debate rounds (0 turns the debate off, max 4)
DEBATE_ROUNDS=2

# ── Search settings ────────────────────────────────────────────────────────
COUNTRY=in
DEFAULT_LANG=en
# Which panches sit on the council: ai_overview, ai_mode, copilot, brave, web
PANCHES=ai_overview,ai_mode,copilot,brave,web

# ── Server, cache, demo ────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
CACHE_TTL_HOURS=72
REQUEST_TIMEOUT=60
# PANCHAYAT_MOCK=1 replays bundled sample data (no SerpApi calls) to try the UI.
PANCHAYAT_MOCK=0
